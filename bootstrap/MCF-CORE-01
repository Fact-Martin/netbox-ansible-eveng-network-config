# This is bootstrap config on L3 switches that act as Edge Router
ip routing

# Hostname config
hostname MCF-CORE-01

# Configure domain name needed to generate ssh keys
ip domain name mcfnetworksecurity.com

# Generate the crypto keys
crypto key generate rsa general-keys modulus 2048

# Enable SSH version 2
ip ssh version 2

# Configure username and this will be used to login using SSH
username martin privilege 15 secret martinchunga

# Configure interface connected to MCF-ROUTER-01,MCF-ROUTER-02,MCF-DIST-01,MCF-DIST-02
interface Ethernet0/1
 description Connected to MCF-ROUTER-02 Ethernet0/1
 no switchport
 ip address 10.100.0.10 255.255.255.252
 no shutdown

interface Ethernet0/0
 description Connected to MCF-ROUTER-01 Ethernet0/1
 no switchport
 ip address 10.100.0.2 255.255.255.252
 no shutdown

interface Ethernet0/2
 description Connected to MCF-DIST-01
 no switchport
 ip address 10.100.0.17 255.255.255.252
 no shutdown

interface Ethernet0/3
 description Connected to MCF-DIST-02
 no switchport
 ip address 10.100.0.21 255.255.255.252
 no shutdown

# Enable OSPF for connectivity
router ospf 1
 network 10.100.0.0 0.0.255.255 area 0

# Configure SSH to allow login
line vty 0 4
 login local
 transport input ssh
